# Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
PUBLIC_APP_URL=http://localhost:5000
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/easy_accounting

# Connection pool sizing. The app keeps TWO pools: the request-scoped pool
# (DB_POOL_MAX) that pins one client per request for RLS, and a dedicated
# session-store pool (DB_SESSION_POOL_MAX). Their SUM must stay BELOW your
# database's / pooler's own max-connections limit. For a Supabase SESSION
# pooler (port 5432, pool_size 15), the defaults 8 + 4 = 12 leave safe
# headroom. Raise only in lockstep with a larger pooler tier.
DB_POOL_MAX=8
DB_SESSION_POOL_MAX=4

# OpenAI (server-side only; never use VITE_ for secrets)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OAuth is optional. Leave blank for local email/password authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Private S3-compatible object storage
OBJECT_STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-private-bucket

# Optional for S3-compatible services or local emulators such as MinIO.
# Leave blank for Amazon S3.
AWS_S3_ENDPOINT=

# Prefer AWS IAM roles, profiles, or the standard AWS credential chain.
# Leave these blank when using AWS_PROFILE or a deployment IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Object paths are derived from AWS_S3_BUCKET by default.
# Override only when you need a custom layout.
PUBLIC_OBJECT_SEARCH_PATHS=/your-private-bucket/public
PRIVATE_OBJECT_DIR=/your-private-bucket/private
