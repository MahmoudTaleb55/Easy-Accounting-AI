#!/usr/bin/env bash
#
# Fast static checks that fail at `git commit` time instead of waiting
# for the validation pipeline. Each is also wired into a Replit
# validation workflow + Playwright spec, so `git commit --no-verify`
# is always a safe escape hatch.
#
# Hook is enabled by `core.hooksPath = .husky` (set by
# `scripts/post-merge.sh`). Total runtime budget: ~2s — all checks run
# in a single tsx process to avoid per-script startup overhead.

set -e

if [ -x "./node_modules/.bin/tsx" ]; then
  TSX="./node_modules/.bin/tsx"
else
  TSX="npx tsx"
fi

$TSX scripts/run-precommit-checks.ts
