modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-overflow"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migrations-prefix"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migrations-runner"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "role-guard-coverage"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dev-only-routes-production-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unit-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migrations-fk-coverage"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "reversal-stamp-backfill"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "WORKSPACE_ISOLATION_GUARD=throw npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "mobile-overflow"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_NO_WEBSERVER=1 npx playwright test --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "migrations-prefix"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_NO_WEBSERVER=1 npx playwright test tests/e2e/migrations-prefix.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "migrations-runner"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_NO_WEBSERVER=1 npx playwright test tests/e2e/migrations-runner.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "role-guard-coverage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_NO_WEBSERVER=1 npx playwright test tests/e2e/role-guard-coverage.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "dev-only-routes-production-gate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_NO_WEBSERVER=1 npx playwright test tests/e2e/dev-only-routes-production-gate.spec.ts --reporter=line"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "unit-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run --reporter=verbose"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "migrations-fk-coverage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_NO_WEBSERVER=1 npx playwright test tests/e2e/database-fk-declared-vs-live.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "reversal-stamp-backfill"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_NO_WEBSERVER=1 npx playwright test tests/e2e/reversal-stamp-backfill-coverage.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_database:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_log_in_with_replit:2.0.0", "javascript_object_storage:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
